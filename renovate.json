{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>securesign/renovate-config//org-inherited-config.json"
  ],
  "enabledManagers": [
    "dockerfile",
    "pip_requirements",
    "tekton"
  ],
  "ignorePaths": [
    "Containerfile",
    "benchmarks/**",
    "slsa_for_models/**"
  ],
  "packageRules": [
    {
      "description": "Disable GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      "description": "Disable updates for upstream-only Docker images",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "gcr.io/google.com/cloudsdktool/cloud-sdk"
      ],
      "enabled": false
    }
  ]
}
